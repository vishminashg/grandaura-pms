# Firebase web app config — from Firebase Console > Project Settings > General
# > Your apps > SDK setup and configuration. These are safe to expose in a
# client bundle (that's how Firebase web apps work); real protection comes
# from firestore.rules and Firebase Authentication, not from hiding these.
#
# Copy this file to .env.local and fill in your own project's values, or set
# the same variable names in your hosting provider's environment settings
# (e.g. Netlify: Site settings > Environment variables).
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# Optional: only needed if you use a named Firestore database instead of
# the default one.
VITE_FIREBASE_FIRESTORE_DB_ID="(default)"

# --- Used only by scripts/seed-staff.mjs (never shipped to the browser) ---
# Path to a Firebase Admin SDK service account JSON key, downloaded from
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Keep this file OUT of git (it already is, via .gitignore).
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
